# CreativeFlow backend environment
#
# These keys are consumed only on the server. They are never sent to the
# browser. Set real values in the Render dashboard (creativeflow →
# Environment → Add Environment Variable) — never commit them to Git.

# HTTP port (Render sets this automatically)
PORT=3000

# --- Provider mode matrix ---
# VOICE_PROVIDER: "browser" (default) or "simulation"
#   browser    = free Web Speech API voice in the client (STT + TTS).
#                No voice credits are consumed — ever.
#   simulation = force the credit-free typed conversation.
# There is NO paid conversational voice provider any more.
VOICE_PROVIDER=

# COPILOT_PROVIDER: "mock" (default) or "live"
#   mock = deterministic local intake logic, no external calls
#   live = every turn is sent to the workflow below
COPILOT_PROVIDER=

# --- Conversational brain (live mode): Activepieces /sync → Groq ---
# Synchronous HTTP workflow endpoint. Receives
# {sessionId, userMessage, conversationState} and must return
# {responseText, requirements, missing, complete, readyForProduction,
#  productionBrief}.
COPILOT_WORKFLOW_URL=

# Optional bearer token sent as Authorization: ****** (leave empty if the
# workflow URL already embeds its own secret).
COPILOT_AUTH_TOKEN=

# Optional shared secret for the OpenAI-compatible custom-LLM endpoint
# (/api/copilot/llm/v1/chat/completions). Only relevant if an external
# OpenAI-compatible client is ever pointed at this backend.
COPILOT_LLM_API_KEY=

# --- Natural text-to-speech (POST /api/tts, server-side only) ---
# The AI reply (responseText only) is synthesized on the server so the
# provider API key NEVER reaches the browser. When no provider is
# configured, /api/tts returns 503 and the frontend falls back to the
# free window.speechSynthesis voice.
#
# TTS_PROVIDER: "elevenlabs" | "openai" | "browser" (auto-detected when
# empty: ELEVENLABS_API_KEY present → elevenlabs; TTS_API_KEY+TTS_API_URL
# → openai; otherwise browser fallback).
TTS_PROVIDER=

# elevenlabs provider — the plain text-to-speech HTTP endpoint ONLY.
# This is NOT the retired Conversational AI agent: no agent session, no
# conversation token, no WebRTC, no agent LLM. One stateless synthesis
# request per AI reply, on the cheapest model (eleven_flash_v2_5).
ELEVENLABS_API_KEY=
# Voice preset id (default: Rachel) and model override:
TTS_VOICE_ID=
TTS_MODEL=

# openai-compatible provider — any /audio/speech endpoint
# (e.g. TTS_API_URL=https://api.openai.com/v1).
TTS_API_URL=
TTS_API_KEY=
TTS_VOICE=

# --- Retired: ElevenLabs conversational agent ---
# The ElevenLabs Conversational AI agent was removed from the voice loop
# (it consumed credits too quickly). The /api/elevenlabs/token route is no
# longer registered and ELEVENLABS_AGENT_ID is unused — delete it from the
# Render dashboard. ELEVENLABS_API_KEY above is reused ONLY for stateless
# TTS synthesis.
# ELEVENLABS_AGENT_ID=

# --- Future provider integrations (unused while services are mocked) ---

# Gemini / Veo — image + video generation (GeminiVeoProductionService)
GEMINI_API_KEY=

# Composio — tool / MCP layer. When COMPOSIO_API_KEY is set the video
# pipeline (POST /api/video/generate) runs real Gemini Veo generation through
# Composio's hosted GEMINI_GENERATE_VIDEOS / GEMINI_WAIT_FOR_VIDEO tools.
# Without it, a mock provider simulates generation.
COMPOSIO_API_KEY=
# Optional overrides for the video pipeline:
# VIDEO_GEN_PROVIDER=composio|mock   (auto-detected from COMPOSIO_API_KEY)
# COMPOSIO_API_URL=https://backend.composio.dev   (REST transport override, tests)
# (COMPOSIO_MCP_URL is retired: the SDK session supplies its own MCP URL)
#   MCP transport (header x-consumer-api-key). Auto-selected when the key
#   starts with ck_ (consumer key); ak_ keys use the REST v3 API.
# COMPOSIO_USER_ID=default
