# CreativeFlow backend environment
#
# These keys are consumed only on the server. They are never sent to the
# browser. Set real values in the Render dashboard (creativeflow →
# Environment → Add Environment Variable) — never commit them to Git.

# HTTP port (Render sets this automatically)
PORT=3000

# --- ElevenLabs Agents (live browser voice conversation) ---
# Server-only secret. The backend exchanges it for a short-lived
# conversation token at GET /api/elevenlabs/token; the key itself
# never reaches frontend JavaScript.
ELEVENLABS_API_KEY=

# The ElevenLabs agent id for the CreativeFlow Creative Director agent.
# Not the secret key, but kept server-side as well.
ELEVENLABS_AGENT_ID=

# --- Future provider integrations (unused while services are mocked) ---

# Gemini / Veo — image + video generation (GeminiVeoProductionService)
GEMINI_API_KEY=

# Composio — tool / MCP layer
COMPOSIO_API_KEY=
