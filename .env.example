# CreativeFlow backend environment
#
# These keys are consumed only on the server. They are never sent to the
# browser. Set real values in the Render dashboard (creativeflow →
# Environment → Add Environment Variable) — never commit them to Git.

# HTTP port (Render sets this automatically)
PORT=3000

# --- Provider mode matrix (spec: test without consuming credits) ---
# VOICE_PROVIDER: "elevenlabs" (default when EL vars are set) or "simulation"
#   simulation = credit-free typed conversation; no ElevenLabs session is
#   ever created.
VOICE_PROVIDER=

# COPILOT_PROVIDER: "mock" (default) or "live"
#   mock = deterministic local intake logic, no external calls
#   live = every turn is sent to the Copilot Studio workflow below
COPILOT_PROVIDER=

# --- Copilot Studio (conversational brain, live mode) ---
# Synchronous HTTP workflow endpoint (e.g. Power Automate "When an HTTP
# request is received" flow with a Response action). Receives
# {sessionId, userMessage, conversationState} and must return
# {responseText, requirements, missing, complete, readyForProduction,
#  productionBrief}.
COPILOT_WORKFLOW_URL=

# Optional bearer token sent as Authorization: Bearer <token>.
# (Power Automate URLs already embed a sig= secret — leave empty then.)
COPILOT_AUTH_TOKEN=

# Optional shared secret for the OpenAI-compatible custom-LLM endpoint
# (/api/copilot/llm/v1/chat/completions). Set the same value as the
# "API key" of the Custom LLM in the ElevenLabs agent dashboard.
COPILOT_LLM_API_KEY=

# --- ElevenLabs Agents (voice/audio transport only) ---
# Server-only secret. The backend exchanges it for a short-lived
# conversation token at GET /api/elevenlabs/token; the key itself
# never reaches frontend JavaScript.
ELEVENLABS_API_KEY=

# The ElevenLabs agent id for the CreativeFlow voice agent.
# Not the secret key, but kept server-side as well.
ELEVENLABS_AGENT_ID=

# --- Future provider integrations (unused while services are mocked) ---

# Gemini / Veo — image + video generation (GeminiVeoProductionService)
GEMINI_API_KEY=

# Composio — tool / MCP layer
COMPOSIO_API_KEY=
